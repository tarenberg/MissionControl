generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GithubAccount {
  id          String   @id @default(cuid())
  login       String   @unique
  avatarUrl   String?
  accessToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contact {
  id          String    @id @default(cuid())
  name        String
  email       String?
  role        String?
  githubLogin String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]
  projects    Project[] @relation("ContactToProject")
}

model Project {
  id           String                 @id @default(cuid())
  title        String
  description  String?
  status       String                 @default("active")
  githubRepo   String?
  githubUrl    String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  localUrl     String?
  devUrl       String?
  archivedPath String?
  artPieces    ArtPiece[]
  notes        Note[]
  tasks        Task[]
  contacts     Contact[]              @relation("ContactToProject")
  webhookConfig GithubWebhookConfig?
  syncLogs     GithubSyncLog[]
}

model Task {
  id                String   @id @default(cuid())
  title             String
  description       String?
  status            String   @default("Backlog")
  assignedTo        String?
  projectId         String?
  githubIssueNumber Int?
  githubIssueUrl    String?
  githubPrNumber    Int?
  githubPrUrl       String?
  githubStatus      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  contact           Contact? @relation(fields: [assignedTo], references: [id])
  project           Project? @relation(fields: [projectId], references: [id])
}

model CalendarEvent {
  id            String    @id @default(cuid())
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime?
  allDay        Boolean   @default(false)
  location      String?
  googleEventId String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AgentLog {
  id        String   @id @default(cuid())
  agentId   String
  sessionId String?
  level     String
  message   String
  subsystem String?
  createdAt DateTime @default(now())
}

model CronRun {
  id         String   @id @default(cuid())
  jobId      String
  jobName    String
  status     String
  durationMs Int?
  error      String?
  ranAt      DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  content   String
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project? @relation(fields: [projectId], references: [id])
}

model ArtPiece {
  id         String   @id @default(cuid())
  title      String
  medium     String?
  status     String   @default("in-progress")
  year       Int?
  dimensions String?
  imageUrl   String?
  projectId  String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project? @relation(fields: [projectId], references: [id])
}

model ClimateLog {
  id          String   @id @default(cuid())
  temperature Float
  humidity    Float?
  deviceId    String?
  timestamp   DateTime @default(now())
}

model ChatRoom {
  id        String        @id @default(cuid())
  name      String?
  type      String        @default("direct") // "direct" or "group"
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  role      String   @default("user") // "user" or "assistant"
  roomId    String
  room      ChatRoom @relation(fields: [roomId], references: [id])
  createdAt DateTime @default(now())
}

model JournalEntry {
  id        String         @id @default(cuid())
  title     String?
  content   String
  mood      String?        // e.g., "happy", "reflective", "inspired"
  location  String?        // optional geotag or description (e.g. "New Haven, CT")
  weather   String?        // e.g. "☀️ 72°F" or "🌧️ 58°F"
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  media     JournalMedia[]
}

model JournalMedia {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  url            String       // local URL, e.g., "/uploads/journal/abc.jpg"
  type           String       // "image" or "video"
  filename       String
  createdAt      DateTime     @default(now())
}

model GithubWebhookConfig {
  id            String   @id @default(cuid())
  projectId     String   @unique
  repoOwner     String
  repoName      String
  webhookSecret String?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id])
}

model GithubSyncLog {
  id             String   @id @default(cuid())
  projectId      String
  syncType       String   // 'webhook' | 'manual' | 'scheduled'
  status         String   // 'success' | 'error'
  message        String?
  itemsProcessed Int      @default(0)
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id])
}
