generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/mission-control.db"
}

model GithubAccount {
  id          String   @id @default(cuid())
  login       String   @unique
  avatarUrl   String?
  accessToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contact {
  id          String    @id @default(cuid())
  name        String
  email       String?
  role        String?
  githubLogin String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]
  projects    Project[] @relation("ContactToProject")
}

model Project {
  id           String     @id @default(cuid())
  title        String
  description  String?
  status       String     @default("active")
  githubRepo   String?
  githubUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  localUrl     String?
  devUrl       String?
  archivedPath String?
  artPieces    ArtPiece[]
  notes        Note[]
  tasks        Task[]
  contacts     Contact[]  @relation("ContactToProject")
}

model Task {
  id                String   @id @default(cuid())
  title             String
  description       String?
  status            String   @default("Backlog")
  assignedTo        String?
  projectId         String?
  githubIssueNumber Int?
  githubIssueUrl    String?
  githubPrNumber    Int?
  githubPrUrl       String?
  githubStatus      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  contact           Contact? @relation(fields: [assignedTo], references: [id])
  project           Project? @relation(fields: [projectId], references: [id])
}

model CalendarEvent {
  id            String    @id @default(cuid())
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime?
  allDay        Boolean   @default(false)
  location      String?
  googleEventId String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AgentLog {
  id        String   @id @default(cuid())
  agentId   String
  sessionId String?
  level     String
  message   String
  subsystem String?
  createdAt DateTime @default(now())
}

model CronRun {
  id         String   @id @default(cuid())
  jobId      String
  jobName    String
  status     String
  durationMs Int?
  error      String?
  ranAt      DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  content   String
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project? @relation(fields: [projectId], references: [id])
}

model ArtPiece {
  id         String   @id @default(cuid())
  title      String
  medium     String?
  status     String   @default("in-progress")
  year       Int?
  dimensions String?
  imageUrl   String?
  projectId  String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project? @relation(fields: [projectId], references: [id])
}

model ClimateLog {
  id          String   @id @default(cuid())
  temperature Float
  humidity    Float?
  deviceId    String?
  timestamp   DateTime @default(now())
}

model ChatRoom {
  id        String        @id @default(cuid())
  name      String?
  type      String        @default("direct") // "direct" or "group"
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  role      String   @default("user") // "user" or "assistant"
  roomId    String
  room      ChatRoom @relation(fields: [roomId], references: [id])
  createdAt DateTime @default(now())
}
